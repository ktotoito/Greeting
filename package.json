{
  "name": "greeting",
  "displayName": "Greeting",
  "description": "Says a passive-agressive hello to you after a long break",
  "version": "0.0.1",
  "publisher": "ktotoito",
  "repository": {
    "type": "git",
    "url": "https://github.com/ktotoito/Greeting"
  },
  "engines": {
    "vscode": "^1.105.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": ["onStartupFinished"],
  "main": "./extension.js",
  "contributes": {
    "commands": [{
      "command": "hello.change_interval",
      "title": "Change Interval"
    },
    {
      "command": "hello.picked_interval",
      "title": "Picked Interval"
    }]
  },
  "scripts": {
    "lint": "eslint .",
    "pretest": "npm run lint",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/vscode": "^1.105.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "eslint": "^9.36.0",
    "@vscode/test-cli": "^0.0.11",
    "@vscode/test-electron": "^2.5.2"
  }
}
